# Think9 Intelligence Hub Environment Configuration
PORT=8000
DATABASE_URL=sqlite:///./think9_intelligence.db

# LLM API Keys (Set at least one of these or use mockup/fallback mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mode configurations
USE_MOCK_LLM=true # Set to false if you supply working API keys above
